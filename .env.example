# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
PAYMENT_MODE=live
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
# Browser no longer needs direct RPC access; wallet signing is routed through the server.
NEXT_PUBLIC_TREASURY_ADDRESS=REPLACE_ME
NEXT_PUBLIC_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
SOLANA_COMMITMENT=confirmed
MINIMUM_PAYMENT_USD=1

# Gateway
GATEWAY_PROVIDER=nowpayments
GATEWAY_API_KEY=REPLACE_ME
GATEWAY_WEBHOOK_SECRET=REPLACE_ME
GATEWAY_API_URL=https://api.nowpayments.io

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_ME
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_ME
SUPABASE_SECRET_KEY=REPLACE_ME

# Rate limiting (Upstash Redis)
# Leave blank for local development. Fill both values in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
FAIL_CLOSED_RATE_LIMIT=false

# Pricing
PRICE_PROVIDER=coingecko
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# Job auth / NFT worker
CRON_SECRET=REPLACE_ME
MINT_JOB_SECRET=REPLACE_ME
NFT_AUTHORITY_PRIVATE_KEY=REPLACE_ME_BASE58
STORAGE_API_URL=https://api.pinata.cloud
STORAGE_API_KEY=REPLACE_ME
STORAGE_GATEWAY_URL=https://gateway.pinata.cloud/ipfs
NFT_COLLECTION_ADDRESS=

# Error monitoring
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional social links
NEXT_PUBLIC_X_URL=https://x.com/
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/
